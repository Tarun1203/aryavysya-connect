// Arya Vysya Vamsha Vruksham – family tree data model.
// Connection URL lives in prisma.config.ts (DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// SUPER_ADMIN is the platform owner. The other admin roles are "secondary admins"
/// tied to a community body, each limited to its own state / district / sangha.
enum Role {
  MEMBER
  LOCAL_ADMIN // office bearer of a local sangha / sabha – endorses its members
  DISTRICT_INCHARGE // the one person in charge of a district – final approval, edits the district
  STATE_ADMIN // state head body (Mahasabha / Mahamandali / Akhila Bharatha Sangham)
  SUPER_ADMIN // platform owner – states, gotras, districts, appoints state heads
}

enum OrgLevel {
  NATIONAL
  STATE
  DISTRICT
  LOCAL
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PersonStatus {
  UNCLAIMED // added by a relative or an admin; nobody has registered as this person yet
  CLAIMED // a registered member is this person
  MERGED // duplicate folded into mergedIntoId
}

enum MarriageStatus {
  PROPOSED // waiting for the other family (or their in-charge) to accept
  CONFIRMED
  WIDOWED
  DIVORCED
}

/// A proposed change to a person's record, a request to remove a link, or a dispute
enum ChangeKind {
  /// New values for some of the person's details
  EDIT
  /// Remove a parent–child link or a marriage
  UNLINK
  /// "This is wrong" – about the details, a parent link or a marriage
  DISPUTE
}

enum ChangeStatus {
  PENDING
  /// Applied (edit, unlink) or upheld (dispute)
  APPROVED
  REJECTED
  /// Taken back by the person who made it
  WITHDRAWN
}

/// What a grievance is about (DPDP Act 2023: the rights of a Data Principal, and complaints)
enum GrievanceKind {
  ACCESS
  CORRECTION
  ERASURE
  CONSENT
  NOMINATION
  CHILD_SAFETY
  COMPLAINT
  OTHER
}

enum GrievanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// Why a one-time code was sent
enum OtpPurpose {
  /// Signing in with a verified phone number
  LOGIN
  /// Proving a phone number belongs to the signed-in member
  VERIFY_PHONE
}

/// What a person's data is used for (DPDP Act 2023: consent is per purpose)
enum ConsentPurpose {
  /// Processing the member's own details to verify and keep their membership
  MEMBERSHIP
  /// Showing the person in the family trees and search to verified members
  FAMILY_TREE
  /// Showing their photo
  PHOTO
}

/// On whose authority consent was given
enum ConsentBasis {
  /// The person themselves
  SELF
  /// A parent, as guardian of a minor, through their own verified account
  GUARDIAN
  /// A signed paper form, seen and recorded by an administrator
  OFFLINE_FORM
  /// A family member confirmed the (adult, unregistered) person agreed – used for photos
  FAMILY
}

enum RuleLevel {
  ALLOW // not checked
  WARN // shown; the member must confirm, and the confirmation is audited
  BLOCK
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Every member belongs to exactly one district, which has one in-charge person.
model District {
  id        String   @id @default(cuid())
  name      String
  state     String
  /// Local Government Directory (LGD) district code, when loaded from LGD
  lgdCode   Int?     @unique
  createdAt DateTime @default(now())

  inchargeId String? @unique
  incharge   User?   @relation("DistrictIncharge", fields: [inchargeId], references: [id], onDelete: SetNull)

  users         User[]
  persons       Person[]
  claims        FamilyClaim[]
  organizations Organization[]
  taluks        Taluk[]
  localities    Locality[]

  @@unique([state, name])
}

/// Taluk / mandal / tehsil (LGD "sub-district")
model Taluk {
  id      String @id @default(cuid())
  name    String
  lgdCode Int?   @unique

  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  localities    Locality[]
  organizations Organization[]

  @@unique([districtId, name])
}

enum LocalityKind {
  VILLAGE // LGD village
  POST_OFFICE // India Post office (B.O / S.O / H.O)
}

/// A village (from LGD) or a post office (from India Post), with its pincode when known.
model Locality {
  id         String       @id @default(cuid())
  /// Stable import key: "v:<lgd code>" for villages, "po:<pincode>:<name>" for post offices
  key        String       @unique
  name       String
  nameLocal  String?
  kind       LocalityKind
  pincode    String?
  officeType String?
  lgdCode    Int?
  latitude   Float?
  longitude  Float?

  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  talukId    String?
  taluk      Taluk?   @relation(fields: [talukId], references: [id], onDelete: SetNull)

  nativeOf      Person[]       @relation("NativeLocality")
  bornIn        Person[]       @relation("BirthLocality")
  claims        FamilyClaim[]
  organizations Organization[]

  @@index([districtId, talukId, name])
  @@index([pincode])
}

/// A community body: Akhila Bharatha sangham (national), Mahasabha / Mahamandali (state),
/// district sangham, or a local sangha / sabha in a town or mandal.
model Organization {
  id        String   @id @default(cuid())
  name      String
  nameLocal String?
  level     OrgLevel
  /// Free label shown to users, e.g. "Mahasabha", "Mahamandali", "Sangham", "Sabha"
  kind      String
  state     String?
  town      String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])
  talukId    String?
  taluk      Taluk?    @relation(fields: [talukId], references: [id], onDelete: SetNull)
  localityId String?
  locality   Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)

  parentId String?
  parent   Organization?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Organization[] @relation("OrgTree")

  members User[]        @relation("OrgMember")
  admins  User[]        @relation("OrgAdmin")
  claims  FamilyClaim[]

  @@index([level, state])
  @@index([districtId])
}

/// One of the 102 Arya Vysya gotras (managed by super admins).
model Gotra {
  id            String   @id @default(cuid())
  /// Position in the traditional list of 102 gotras
  no            Int?     @unique
  name          String   @unique
  /// Sankethanamams (kula names) that belong to this gotra
  kulas         String[] @default([])
  /// Kula names in the other scripts, keyed by the English name: { "Arasakula": { te, kn, ta } }
  kulaNames     Json     @default("{}")
  /// The Telugu / Kannada / Tamil spellings have been checked by a native speaker
  localVerified Boolean  @default(false)
  nameTe        String?
  nameKn        String?
  nameTa        String?
  rishi         String?

  persons         Person[]
  birthPersons    Person[]      @relation("BirthGotra")
  maternalPersons Person[]      @relation("MaternalGotra")
  claims          FamilyClaim[]
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  /// @encrypted(deterministic) – looked up when signing in with a code (src/lib/encryption.ts)
  phone           String?
  /// Set once the member proved the number with a one-time code; only verified numbers can sign in
  phoneVerifiedAt DateTime?
  passwordHash    String
  role            Role       @default(MEMBER)
  status          UserStatus @default(PENDING)
  locale          String     @default("en")

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  /// Local sangha / sabha the member belongs to (optional)
  organizationId String?
  organization   Organization? @relation("OrgMember", fields: [organizationId], references: [id], onDelete: SetNull)

  /// Body this user administers (LOCAL_ADMIN → local org, STATE_ADMIN → state org)
  adminOrgId String?
  adminOrg   Organization? @relation("OrgAdmin", fields: [adminOrgId], references: [id], onDelete: SetNull)

  /// District this user is in charge of (DISTRICT_INCHARGE)
  inchargeOf District? @relation("DistrictIncharge")

  /// The tree node that represents this user. Set only by an approval.
  personId String? @unique
  person   Person? @relation("UserSelf", fields: [personId], references: [id])

  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  claims             FamilyClaim[]   @relation("ClaimUser")
  reviewedClaims     FamilyClaim[]   @relation("ClaimReviewer")
  endorsedClaims     FamilyClaim[]   @relation("ClaimEndorser")
  audit              AuditLog[]
  marriagesProposed  Couple[]        @relation("MarriageProposer")
  marriagesConfirmed Couple[]        @relation("MarriageConfirmer")
  consents           Consent[]       @relation("ConsentSubject")
  verifiedPeople     Person[]        @relation("PersonVerifier")
  changesProposed    ChangeRequest[] @relation("ChangeProposer")
  changesReviewed    ChangeRequest[] @relation("ChangeReviewer")
  consentsGiven      Consent[]       @relation("ConsentGiver")
  consentsWithdrawn  Consent[]       @relation("ConsentWithdrawer")
  otpChallenges      OtpChallenge[]
}

/// A member's request to be verified as belonging to a family.
/// Either points at an existing person, or carries details to create one.
model FamilyClaim {
  id     String      @id @default(cuid())
  status ClaimStatus @default(PENDING)

  userId String
  user   User   @relation("ClaimUser", fields: [userId], references: [id], onDelete: Cascade)

  districtId String
  district   District @relation(fields: [districtId], references: [id])

  /// Local sangha / sabha that should endorse this member first (optional)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  endorsedById   String?
  endorsedBy     User?         @relation("ClaimEndorser", fields: [endorsedById], references: [id])
  endorsedAt     DateTime?

  /// Existing person the member says they are (optional)
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  givenName        String
  surname          String
  gender           Gender
  fatherName       String?
  motherName       String?
  birthYear        Int?
  nativePlace      String?
  /// Native village / post office picked from the location directory
  nativeLocalityId String?
  nativeLocality   Locality? @relation(fields: [nativeLocalityId], references: [id], onDelete: SetNull)
  gotraId          String?
  gotra            Gotra?    @relation(fields: [gotraId], references: [id])
  note             String?

  reviewedById String?
  reviewedBy   User?     @relation("ClaimReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())
}

model Person {
  /// Opaque, immutable identity – never shown, never keyed on a name, phone or ID
  id           String       @id @default(cuid())
  /// Human-facing member code (shown as AVC-000123); a label for support, not the identity
  memberNo     Int          @unique @default(autoincrement())
  status       PersonStatus @default(UNCLAIMED)
  /// Set when this record was merged into another; lookups redirect there
  mergedIntoId String?
  /// An administrator checked these details; members' edits then go for review (src/lib/review.ts)
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?        @relation("PersonVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  givenName      String
  /// Intiperu – the family (house) name
  surname        String
  givenNameLocal String?
  surnameLocal   String?
  /// Other names this person is known by (birth name, married name, aka) – a name change updates, never duplicates
  aliases        String[] @default([])
  gender         Gender

  /// Swa gotra (own): the father's for men and unmarried women; a married woman's becomes her
  /// husband's. Derived from the fields below and the marriages – see src/lib/gotra.ts.
  gotraId         String?
  gotra           Gotra?  @relation(fields: [gotraId], references: [id])
  /// Birth gotra (puttinti): the father's gotra at birth. Never changes with marriage.
  birthGotraId    String?
  birthGotra      Gotra?  @relation("BirthGotra", fields: [birthGotraId], references: [id])
  /// The mother's birth gotra – shown for children and used in the marriage check
  maternalGotraId String?
  maternalGotra   Gotra?  @relation("MaternalGotra", fields: [maternalGotraId], references: [id])

  isLiving         Boolean   @default(true)
  /// Free-form dates: "1952", "1952-03" or "1952-03-14"
  birthDate        String?
  /// Child no. among brothers and sisters (1 = eldest), for when birth dates are unknown or wrong.
  /// Siblings are ordered by this, then by birth date – see siblingOrder in src/lib/tree.ts.
  birthOrder       Int?
  /// Display text; birthLocality links it to the location directory when picked from there
  birthPlace       String?
  birthLocalityId  String?
  birthLocality    Locality? @relation("BirthLocality", fields: [birthLocalityId], references: [id], onDelete: SetNull)
  deathDate        String?
  /// Tithi of death, used for the annual shraddham / aabdikam
  deathTithi       String?
  /// Native place (ooru) display text; nativeLocality links it to the location directory
  nativePlace      String?
  nativeLocalityId String?
  nativeLocality   Locality? @relation("NativeLocality", fields: [nativeLocalityId], references: [id], onDelete: SetNull)
  nakshatra        String?
  rasi             String?
  kuladevata       String?   @default("Vasavi Kanyaka Parameswari")
  occupation       String?
  currentCity      String?
  notes            String?

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asChild        ParentChild[]   @relation("ChildLink")
  asParent       ParentChild[]   @relation("ParentLink")
  couples1       Couple[]        @relation("Partner1")
  couples2       Couple[]        @relation("Partner2")
  user           User?           @relation("UserSelf")
  photo          PersonPhoto?
  claims         FamilyClaim[]
  consents       Consent[]
  changeRequests ChangeRequest[]

  @@index([surname, givenName])
  @@index([gotraId])
  @@index([districtId])
}

model ParentChild {
  id           String    @id @default(cuid())
  parentId     String
  childId      String
  /// BIOLOGICAL | ADOPTED
  type         String    @default("BIOLOGICAL")
  /// Reported until an administrator verifies the link; "disputed" while a dispute about it is open
  verifiedAt   DateTime?
  verifiedById String?

  parent Person @relation("ParentLink", fields: [parentId], references: [id], onDelete: Cascade)
  child  Person @relation("ChildLink", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([childId])
}

/// A marriage – the link that joins two family charts. person1 is the side that made the link,
/// person2 the side that has to accept it when they belong to another family's chart.
/// Remarriage is a new record; ended marriages keep their status and dates.
model Couple {
  id           String         @id @default(cuid())
  person1Id    String
  person2Id    String
  status       MarriageStatus @default(CONFIRMED)
  /// Free-form dates like the person dates: "1975", "1975-05" or "1975-05-14"
  marriageDate String?
  endDate      String?

  proposedById  String?
  proposedBy    User?     @relation("MarriageProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  confirmedById String?
  confirmedBy   User?     @relation("MarriageConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())

  person1 Person @relation("Partner1", fields: [person1Id], references: [id], onDelete: Cascade)
  person2 Person @relation("Partner2", fields: [person2Id], references: [id], onDelete: Cascade)

  @@unique([person1Id, person2Id])
  @@index([person2Id])
}

/// Every change to the tree is recorded for AVOPA review.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

/// Marriage customs differ by region, so the marriage check reads its rules per state.
/// The row with state "*" is the default for states without their own row.
model MarriageRule {
  id                         String    @id @default(cuid())
  state                      String    @unique
  /// Same birth gotra on both sides
  sagotra                    RuleLevel @default(WARN)
  /// One side's gotra is the other's mother's gotra
  maternalGotra              RuleLevel @default(WARN)
  /// Cross cousins (children of a brother and a sister)
  menarikam                  RuleLevel @default(WARN)
  /// After widowhood or divorce a woman keeps her husband's gotra (otherwise back to her birth gotra)
  keepGotraAfterMarriageEnds Boolean   @default(true)
  updatedById                String?
  updatedAt                  DateTime  @updatedAt
}

/// A person's photo, kept small (resized to 320px in the browser) and in the database so it
/// survives redeploys. Hidden photos are shown only to the people who manage them (see lib/photo.ts).
model PersonPhoto {
  personId     String   @id
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  data         Bytes
  mime         String
  /// Shown to members in the tree and on the person page. Off by default for women.
  visible      Boolean  @default(false)
  uploadedById String?
  /// When the uploader confirmed they have the person's (or, for a minor, the guardian's) consent
  consentAt    DateTime
  updatedAt    DateTime @updatedAt
}

/**
 * A consent record (DPDP Act 2023): whose data, for what purpose, on what basis, given by whom and
 * against which notice wording, and when. Records are never edited: withdrawing sets withdrawnAt,
 * and giving consent again adds a new record. See src/lib/consent.ts.
 */
model Consent {
  id               String         @id @default(cuid())
  purpose          ConsentPurpose
  basis            ConsentBasis
  /// The person the data is about; empty only while a registration is still waiting for approval
  personId         String?
  person           Person?        @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// The account of the person the data is about, for consent given at registration
  userId           String?
  user             User?          @relation("ConsentSubject", fields: [userId], references: [id], onDelete: Cascade)
  /// Who gave it: the person, the parent, or the administrator who recorded a paper form
  givenById        String?
  givenBy          User?          @relation("ConsentGiver", fields: [givenById], references: [id], onDelete: SetNull)
  /// For a guardian or a paper form: the guardian's name and relationship to the person
  guardianName     String?
  guardianRelation String?
  /// Which wording of the consent notice was agreed to (CONSENT_NOTICE_VERSION)
  noticeVersion    String
  givenAt          DateTime       @default(now())
  withdrawnAt      DateTime?
  withdrawnById    String?
  withdrawnBy      User?          @relation("ConsentWithdrawer", fields: [withdrawnById], references: [id], onDelete: SetNull)

  @@index([personId, purpose])
  @@index([userId])
}

/**
 * A one-time code sent by SMS (MSG91). Only a hash of the code is stored; it expires, allows a few
 * attempts, and is used once. A request for a number no member has verified is logged too (no
 * user, no code, nothing sent), so the limits and replies are the same whoever asks. See src/lib/otp.ts.
 */
model OtpChallenge {
  id         String     @id @default(cuid())
  /// Digits with the country code, e.g. 919876543210
  /// @encrypted(deterministic)
  phone      String
  purpose    OtpPurpose
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// HMAC of the requester's IP address (never the address itself), for the per-IP limit
  ipHash     String?
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}

/**
 * Proposal → review → decision for changes that need a second pair of eyes: members' edits to
 * verified records or to another member's own record, removing a verified link, and disputes.
 * The proposal keeps only the changed fields as { field: { from, to } }, so applying it never
 * overwrites unrelated edits made in the meantime. See src/lib/review.ts.
 */
model ChangeRequest {
  id         String       @id @default(cuid())
  kind       ChangeKind
  status     ChangeStatus @default(PENDING)
  personId   String
  person     Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// For UNLINK and link disputes: the ParentChild or Couple row, and which of the two it is
  linkId     String?
  linkKind   String?
  /// For EDIT: { field: { from, to } }
  changes    Json?
  /// Why – required for every request
  reason     String
  /// Dispute: what the correct details are, and what supports it (a document, an elder, a register)
  correction String?
  evidence   String?

  proposedById String?
  proposedBy   User?     @relation("ChangeProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedBy   User?     @relation("ChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())

  @@index([personId, status])
  @@index([status, createdAt])
  @@index([proposedById])
}

/**
 * A request or complaint to the Grievance Officer (privacy notice, /grievance). Anyone may send
 * one, signed in or not; it is answered within 30 days (dueAt). See src/app/actions/grievance.ts.
 */
model Grievance {
  id            String          @id @default(cuid())
  /// Shown to the sender as their reference, e.g. G-000123
  number        Int             @unique @default(autoincrement())
  kind          GrievanceKind
  status        GrievanceStatus @default(OPEN)
  name          String
  /// Email or phone to reply to
  /// @encrypted
  contact       String
  /// The member who sent it, when signed in
  userId        String?
  /// The record it is about, if any (member code or link given by the sender)
  aboutText     String?
  /// @encrypted
  message       String
  /// HMAC of the sender's IP, for the per-IP limit
  ipHash        String?
  dueAt         DateTime
  response      String?
  respondedById String?
  respondedAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([status, dueAt])
  @@index([ipHash, createdAt])
}

/**
 * Counters for rate limiting (src/lib/ratelimit.ts): one row per limited key, counted in fixed
 * windows, with progressive blocking after repeated violations. The key is an HMAC of the rule
 * and the subject, so no phone number, email or IP address is stored here.
 */
model RateLimit {
  key          String    @id
  points       Int       @default(0)
  windowEndsAt DateTime
  /// Times the limit was exceeded recently; each one doubles the next block
  strikes      Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([updatedAt])
}
