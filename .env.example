# Postgres connection (cloud: Neon / Supabase / Render / Cloud SQL)
DATABASE_URL="postgresql://vysya:vysya@localhost:5433/vamsha_utf8"
# On Neon: DATABASE_URL is the pooled string (-pooler), this one the direct string, used for migrations.
# Leave unset for the local dev database.
# DATABASE_URL_UNPOOLED=""

# Long random string used to sign login sessions: openssl rand -base64 32
AUTH_SECRET="change-me"

# How many generations up/down an approved member may edit
FAMILY_EDIT_GENERATIONS=5

# First super admin created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"

# Field encryption for columns marked @encrypted in prisma/schema.prisma (phone numbers, grievances).
# Comma-separated "id:key" pairs, each key 32 random bytes in base64; new writes use CURRENT.
# Make a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy somewhere safe: without the key, encrypted values can't be read back.
# After setting it (or adding a new key to rotate), deploy and run `npm run encryption:backfill`.
# FIELD_ENCRYPTION_KEYS="k1:..."
# FIELD_ENCRYPTION_CURRENT="k1"

# Encrypted backups: `npm run backup` writes backups/*.vvbk (pg_dump 17+ needed); `npm run backup:open`
# decrypts one for pg_restore. 32 random bytes, base64 – a different key from the one above, and
# both kept somewhere other than the backups themselves.
# BACKUP_KEY=""

# Sign-in by SMS code (MSG91). Leave empty to hide phone sign-in in production; in development the
# code is printed to the server log instead of being sent.
# MSG91_AUTH_KEY=""
# MSG91_OTP_TEMPLATE_ID=""

# Shown on /privacy, /terms and /grievance: the organisation running the site (Data Fiduciary)
# and its Grievance Officer. Until set, those pages say the details are not yet published.
# LEGAL_ORG_NAME=""
# LEGAL_ORG_ADDRESS=""
# GRIEVANCE_OFFICER_NAME=""
# GRIEVANCE_EMAIL=""
# GRIEVANCE_PHONE=""

# Demo users/family for local testing (leave empty in production)
SEED_DEMO_PASSWORD="demo-vasavi-2026"
